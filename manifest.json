{
	"manifest_version": 3,
	"name": "SteamDB popup hotkeys",
	"version": "1.4.0",
	"description": "Keyboard shortcuts for the Store / Wishlist / Follow / Ignore buttons in SteamDB's game hover popup.",
	"permissions": [ "storage" ],
	"background":
	{
		"scripts": [ "background.js" ],
		"service_worker": "background.js"
	},
	"action":
	{
		"default_title": "SteamDB popup hotkeys",
		"default_popup": "options.html"
	},
	"options_ui":
	{
		"page": "options.html",
		"open_in_tab": false
	},
	"content_scripts":
	[
		{
			"matches": [ "https://steamdb.info/*" ],
			"js": [ "shared.js", "content.js" ],
			"run_at": "document_idle"
		}
	],
	"browser_specific_settings":
	{
		"gecko":
		{
			"id": "steamdb-popup-hotkeys@local",
			"strict_min_version": "128.0"
		}
	}
}
